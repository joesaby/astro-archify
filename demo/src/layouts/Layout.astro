---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — astro-archify demo</title>
    <style>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #ffffff;
        --muted: #6b7280;
        --accent: #4f46e5;
        --border: rgba(128, 128, 128, 0.25);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f4f4f5;
          --bg: #0f1115;
          --muted: #9ca3af;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      nav {
        display: flex;
        gap: 1.25rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      nav a {
        color: var(--fg);
        text-decoration: none;
        font-weight: 600;
      }
      nav a:hover {
        color: var(--accent);
      }
      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      h1 {
        margin-top: 0;
      }
      p.lede {
        color: var(--muted);
      }
      code {
        background: rgba(128, 128, 128, 0.15);
        padding: 0.15em 0.4em;
        border-radius: 0.3em;
      }
      pre > code {
        display: block;
        padding: 1rem;
        overflow-x: auto;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/architecture">Architecture</a>
      <a href="/workflow">Workflow</a>
      <a href="/sequence">Sequence</a>
      <a href="/dataflow">Data flow</a>
      <a href="/lifecycle">Lifecycle</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
