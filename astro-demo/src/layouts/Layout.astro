---
export interface Props {
  title: string;
}

const { title } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/docs/architecture', label: 'Architecture' },
  { href: '/docs/workflow', label: 'Workflow' },
  { href: '/docs/sequence', label: 'Sequence' },
  { href: '/docs/dataflow', label: 'Data flow' },
  { href: '/docs/lifecycle', label: 'Lifecycle' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Standalone Astro demo for astro-archify" />
    <title>{title} — astro-archify demo</title>
    <style>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #ffffff;
        --muted: #6b7280;
        --accent: #4f46e5;
        --border: rgba(128, 128, 128, 0.25);
        --sidebar: #f8fafc;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f4f4f5;
          --bg: #0f1115;
          --muted: #9ca3af;
          --sidebar: #151820;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 240px 1fr;
      }
      aside {
        border-right: 1px solid var(--border);
        background: var(--sidebar);
        padding: 1.5rem 1rem;
      }
      aside h2 {
        margin: 0 0 1rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      aside nav {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      aside a {
        color: var(--fg);
        text-decoration: none;
        padding: 0.35rem 0.5rem;
        border-radius: 0.35rem;
        font-weight: 600;
      }
      aside a:hover,
      aside a[aria-current='page'] {
        color: var(--accent);
        background: rgba(79, 70, 229, 0.08);
      }
      main {
        max-width: 960px;
        padding: 2rem 1.5rem 4rem;
      }
      h1 {
        margin-top: 0;
      }
      p.lede,
      .lede {
        color: var(--muted);
      }
      code {
        background: rgba(128, 128, 128, 0.15);
        padding: 0.15em 0.4em;
        border-radius: 0.3em;
      }
      pre > code {
        display: block;
        padding: 1rem;
        overflow-x: auto;
      }
      @media (max-width: 800px) {
        .shell {
          grid-template-columns: 1fr;
        }
        aside {
          border-right: 0;
          border-bottom: 1px solid var(--border);
        }
        aside nav {
          flex-flow: row wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <h2>astro-archify</h2>
        <nav>
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
